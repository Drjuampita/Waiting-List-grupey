# Copia a .env.local para desarrollo. En Vercel, cada variable se carga por ambiente
# (Preview / Production) con valores DISTINTOS. Nunca subas valores reales al repo.

# Desarrollo: Postgres local con 0026 aplicada. Preview/Production: pooler de Supabase
# en modo transacción (puerto 6543) con el usuario waitlist_writer.<project_ref>.
DATABASE_URL=postgresql://waitlist_writer:<password>@localhost:5432/waitlist_dev
# DATABASE_URL=postgresql://waitlist_writer.<project_ref>:<password>@<pooler-host>:6543/postgres

# Obligatorias en Preview y Production (en desarrollo se usa un limitador en memoria).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Separados por comas. En Preview se agregan solas las URLs del deploy.
ALLOWED_ORIGINS=http://localhost:3000

PRIVACY_POLICY_VERSION=2026-10-15

# 32+ caracteres aleatorios, distinto por ambiente: openssl rand -hex 32
LOG_HASH_SECRET=

RATE_LIMIT_IP_PER_MINUTE=20
RATE_LIMIT_EMAIL_PER_DAY=10

# Opcional: ruta a la CA de Supabase si no está en certs/supabase-ca.crt
# DATABASE_CA_PATH=
